{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  
  "type": "object",

  "required": [
    "id",
    "type",
    "status",
    "version",
    "name",
    "description",
    "properties",
    "implementation",
    "ui"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "const": "tool"
    },
    "status": {
      "enum": ["alpha", "beta", "stable"]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Version number in MAJOR.MINOR.PATCH format."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "object",
      "required": [
        "domain",
        "inputs",
        "outputs",
        "operations"
      ],
      "properties": {
        "domain": {
          "enum": ["text", "number", "image"]
        },
        "inputs": {
          "type": "array",
          "items": {
            "enum": ["string", "number", "boolean"]
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "enum": ["string", "number", "boolean"]
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": ["transform", "validate", "format"]
          }
        }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "required": ["inputs", "actions", "outputs"],
      "properties": {
        "inputs": {
          "type": "array"
        },
        "actions": {
          "type": "array"
        },
        "outputs": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}